# athleticstogether.com — Caddy behind nginx (nginx terminates TLS on :443 and
# proxies to this loopback listener). To let Caddy own the domain directly
# instead, replace the site address with `athleticstogether.com` and remove
# `auto_https off`.
#
# Environment:
#   AT_ROOT      directory holding schema/ (this directory)
#   AT_DSN_FILE  file containing the MySQL/MariaDB DSN, e.g.
#                athleticstogether:PASSWORD@unix(/run/mysqld/mysqld.sock)/athleticstogether
#   AT_DATA      writable directory for uploaded originals
#   AT_LISTEN    listener, default 127.0.0.1:8095
{
	admin off
	auto_https off
	servers {
		trusted_proxies static 127.0.0.1/32 ::1/128
		client_ip_headers X-Forwarded-For
	}
}

http://{$AT_LISTEN:127.0.0.1:8095} {
	encode zstd gzip
	datadriven {
		schema {$AT_ROOT}/schema/athleticstogether.yaml
		database_file mysql {$AT_DSN_FILE}
		site_name "Athletics Together"
		tagline "Plan your training, log every session from your watch, and race virtual events with athletes anywhere."
		home Event Activity
		signup on
		timezone America/Vancouver
		uploads {$AT_DATA}/uploads 25MB
		activity_import {
			activity Activity
			lap Lap
			match PlannedWorkout
			registration EventRegistration
			result EventResult
		}
	}
	respond 404
}
